<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Smart Stairs — Interactive Exhibition</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --navy:#060814;
  --card:#0e1228;
  --card-border:rgba(0,240,255,0.25);
  --led:#00f0ff;
  --led-dim:rgba(0,240,255,0.14);
  --led-glow:rgba(0,240,255,0.5);
  --riser:#181a28;
  --text:#ffffff;
  --muted:#c8d8f0;
  --accent:#2563ff;
  --amber:#ffc837;
  --green:#2ec4b6;
  --radius:22px;
  --trans:cubic-bezier(.4,0,.2,1);
}

html,body{
  height:100%;overflow:hidden;
  background:var(--navy);
  font-family:'Outfit',-apple-system,BlinkMacSystemFont,sans-serif;
  color:var(--text);
  -webkit-tap-highlight-color:transparent;
}

.screen{
  position:fixed;inset:0;
  display:flex;flex-direction:column;
  overflow:hidden;
  opacity:0;pointer-events:none;
  transform:translate3d(0,16px,0);
  transition:opacity 0.42s var(--trans),transform 0.42s var(--trans);
  z-index:5;
}
.screen.active{opacity:1;pointer-events:all;transform:translate3d(0,0,0)}

/* ── INTRO OVERLAY ──────────────────────── */
#intro-overlay{
  position:fixed;inset:0;
  background:rgba(6,8,20,0.94);
  backdrop-filter:blur(18px);
  display:flex;flex-direction:column;
  justify-content:center;align-items:center;
  gap:2rem;z-index:100;padding:28px;
  text-align:center;
  transition:opacity 0.7s ease;
}
#intro-overlay.fade-out{opacity:0;pointer-events:none}

.intro-glow{position:absolute;border-radius:50%;pointer-events:none}
.ig1{width:340px;height:340px;background:radial-gradient(circle,rgba(0,240,255,0.13),transparent 70%);animation:roam1 9s ease-in-out infinite}
.ig2{width:280px;height:280px;background:radial-gradient(circle,rgba(37,99,255,0.11),transparent 70%);animation:roam2 12s ease-in-out infinite}
@keyframes roam1{0%,100%{transform:translate3d(-80px,-100px,0)}40%{transform:translate3d(90px,-20px,0)}70%{transform:translate3d(10px,90px,0)}}
@keyframes roam2{0%,100%{transform:translate3d(80px,90px,0)}40%{transform:translate3d(-90px,50px,0)}70%{transform:translate3d(-10px,-90px,0)}}

.intro-brand{font-size:13px;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);font-weight:800}
.intro-title{font-size:clamp(52px,14vw,72px);font-weight:900;letter-spacing:-.03em;line-height:1.02}
.intro-title span{color:var(--led);text-shadow:0 0 36px rgba(0,240,255,0.55)}
.intro-desc{font-size:19px;color:var(--muted);max-width:340px;line-height:1.55;font-weight:600}

.play-btn{
  width:108px;height:108px;border-radius:50%;
  background:rgba(0,240,255,0.12);
  border:2px solid rgba(0,240,255,0.5);
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;
  transition:transform 0.25s var(--trans),background 0.25s;
  box-shadow:0 0 48px rgba(0,240,255,0.22);
  position:relative;
}
.play-btn::before{
  content:'';position:absolute;inset:-10px;border-radius:50%;
  border:1.5px solid rgba(0,240,255,0.22);
  animation:pulsering 2.2s ease-in-out infinite;
}
@keyframes pulsering{0%,100%{transform:scale(1);opacity:.4}50%{transform:scale(1.09);opacity:1}}
.play-btn:active{background:rgba(0,240,255,0.28);transform:scale(0.95)}
.play-icon{width:0;height:0;border-style:solid;border-width:15px 0 15px 28px;border-color:transparent transparent transparent var(--led);margin-left:8px;filter:drop-shadow(0 0 10px var(--led))}
.play-label{font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);font-weight:800}

/* ── MAIN SCREEN ────────────────────────── */
#main{background:var(--navy);padding:16px 16px 18px;gap:10px}

.main-header{display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
.brand-title{font-size:26px;font-weight:900;letter-spacing:-.02em}
.brand-title span{color:var(--led);text-shadow:0 0 20px rgba(0,240,255,0.5)}

.status-pill{
  display:flex;align-items:center;gap:9px;
  background:rgba(255,255,255,0.06);
  border:1.5px solid var(--card-border);
  padding:8px 16px;border-radius:24px;
  font-size:13px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;
  color:var(--muted);
}
.status-dot{width:10px;height:10px;border-radius:50%}
.status-pill.ready .status-dot{background:var(--green);box-shadow:0 0 10px var(--green);animation:blink 2.2s infinite}
.status-pill.detected .status-dot{background:var(--amber);box-shadow:0 0 10px var(--amber);animation:blink 0.8s infinite}
.status-pill.processing .status-dot{background:var(--accent);box-shadow:0 0 10px var(--accent);animation:blink 0.4s infinite}
.status-pill.active-state .status-dot{background:var(--led);box-shadow:0 0 12px var(--led);animation:blink 1.2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.2}}

/* ── 3D SCENE — fills entire container ── */
.scene-outer-container{
  flex:1;
  width:100%;
  min-height:0;
  display:flex;flex-direction:column;justify-content:center;align-items:center;
  overflow:hidden;border-radius:var(--radius);
  background:radial-gradient(ellipse at 50% 40%,#0d1535 0%,#060814 100%);
  border:2px solid rgba(0,240,255,0.32);
  box-shadow:inset 0 0 60px rgba(0,240,255,0.06),0 0 0 1px rgba(0,240,255,0.08);
  position:relative;
}

.staircase-viewport{
  width:100%;height:100%;
  position:absolute;inset:0;
  perspective:900px;perspective-origin:50% 10%;
  display:flex;justify-content:center;align-items:center;
}

.staircase-scene{
  position:relative;
  width:92%;
  height:72%;
  transform-style:preserve-3d;
  transform:rotateX(38deg) rotateY(0deg);
  will-change:transform;
}
.staircase-scene.intro-blur{filter:blur(14px);transition:filter 0s}
.staircase-scene.unblur{filter:blur(0);transition:filter 1s ease}

/* 3D STEP */
.step-3d{
  position:absolute;left:0;top:0;
  width:100%;
  transform-style:preserve-3d;
}
.step-3d .face{position:absolute;backface-visibility:visible}

.step-3d .tread{
  position:absolute;width:100%;left:0;top:0;
  background:linear-gradient(135deg,#3d2915 0%,#1f140a 100%);
  border:1px solid #5a3e20;
  transform-origin:top center;
}
.step-3d .tread::after{
  content:'';position:absolute;inset:0;
  background:transparent;
  transition:background 0.4s ease;border-radius:1px;
}
.step-3d.lit-below .tread::after{
  background:radial-gradient(ellipse at 50% 0%,rgba(0,240,255,0.38),transparent 78%);
}

.step-3d .riser{
  position:absolute;width:100%;left:0;top:0;
  background:var(--riser);
  border:1px solid rgba(255,255,255,0.08);
  transition:background 0.35s ease;
}
.step-3d.lit .riser{
  background:linear-gradient(180deg,rgba(0,240,255,0.6) 0%,rgba(0,240,255,0.15) 60%,var(--riser) 100%);
}

.step-3d .side-left,.step-3d .side-right{
  position:absolute;top:0;background:#0f101a;border:1px solid rgba(255,255,255,0.05);
}
.step-3d .side-left{left:0}
.step-3d .side-right{right:0}

.step-3d .led-strip{
  position:absolute;top:0;left:0;width:100%;height:5px;
  background:var(--led);
  box-shadow:0 0 18px var(--led),0 2px 8px rgba(0,240,255,0.9);
  opacity:0.28;
  transform:translate3d(0,0,1px);
  transition:opacity 0.35s ease;
}
.step-3d.lit .led-strip{opacity:1}

.staircase-scene:not(.simulation-active) .step-3d:not(.lit) .led-strip{animation:ledbreath 3s ease-in-out infinite}
.staircase-scene:not(.simulation-active) .step-3d:nth-child(2):not(.lit) .led-strip{animation-delay:.3s}
.staircase-scene:not(.simulation-active) .step-3d:nth-child(3):not(.lit) .led-strip{animation-delay:.6s}
.staircase-scene:not(.simulation-active) .step-3d:nth-child(4):not(.lit) .led-strip{animation-delay:.9s}
.staircase-scene:not(.simulation-active) .step-3d:nth-child(5):not(.lit) .led-strip{animation-delay:1.2s}
.staircase-scene:not(.simulation-active) .step-3d:nth-child(6):not(.lit) .led-strip{animation-delay:1.5s}
@keyframes ledbreath{0%,100%{opacity:0.24}50%{opacity:0.72}}

.floor-reflection{
  position:absolute;width:120%;height:400px;
  background:transparent;
  transform:translate3d(-10%,50%,0) rotateX(90deg);
  pointer-events:none;transition:background 0.5s ease;
}
.floor-reflection.lit{background:radial-gradient(circle at 50% 55%,rgba(0,240,255,0.28),transparent 60%)}

/* HUD */
.control-hud-panel{
  width:100%;background:var(--card);
  border:1.5px solid var(--card-border);
  backdrop-filter:blur(12px);
  border-radius:var(--radius);padding:16px 18px;
  display:flex;flex-direction:column;gap:12px;flex-shrink:0;
}
.hud-title{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.14em;font-weight:800}
.hud-flow{display:flex;align-items:center;justify-content:space-between;position:relative}
.hud-node{display:flex;flex-direction:column;align-items:center;gap:6px;z-index:2;width:62px}
.hud-node-circle{
  width:48px;height:48px;border-radius:50%;
  background:rgba(255,255,255,0.05);border:1.5px solid var(--card-border);
  display:flex;align-items:center;justify-content:center;font-size:20px;
  transition:all 0.28s var(--trans);
}
.hud-node-label{font-size:12px;color:var(--muted);text-align:center;font-weight:800;text-transform:uppercase;white-space:nowrap}
.hud-node.active .hud-node-circle{background:rgba(0,240,255,0.18);border-color:var(--led);box-shadow:0 0 18px rgba(0,240,255,0.45);transform:scale(1.12)}
.hud-node.active .hud-node-label{color:#ffffff}
.hud-connector{flex:1;height:3px;background:rgba(255,255,255,0.08);margin:0 -3px 18px;position:relative;overflow:hidden}
.hud-connector-pulse{
  position:absolute;top:0;left:0;height:100%;width:100%;
  background:var(--led);box-shadow:0 0 8px var(--led);
  transform:scaleX(0);transform-origin:left center;will-change:transform;
}

/* BUTTONS */
.main-actions{display:flex;flex-direction:column;gap:10px;width:100%;flex-shrink:0}

.btn-simulate{
  width:100%;padding:17px;border-radius:18px;
  background:linear-gradient(135deg,rgba(0,240,255,0.22),rgba(37,99,255,0.18));
  border:1.5px solid rgba(0,240,255,0.5);
  color:#ffffff;font-size:18px;font-weight:900;
  letter-spacing:.06em;text-transform:uppercase;
  cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;
  transition:transform 0.2s var(--trans),background 0.2s;font-family:inherit;
  box-shadow:0 4px 24px rgba(0,240,255,0.14);
}
.btn-simulate:active{transform:scale(0.97);background:rgba(0,240,255,0.3)}
.btn-simulate:disabled{opacity:.4;pointer-events:none}

.btn-explore-tech{
  width:100%;padding:16px;border-radius:18px;
  background:rgba(255,255,255,0.05);
  border:1.5px solid rgba(255,255,255,0.15);
  color:var(--muted);font-size:18px;font-weight:800;
  cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;
  transition:all 0.2s var(--trans);font-family:inherit;
}
.btn-explore-tech:active{background:rgba(255,255,255,0.1);color:#ffffff}
.btn-explore-tech:disabled{opacity:.4;pointer-events:none}

/* ── HUB ── */
#hub{background:var(--navy);padding:22px 18px 32px;overflow-y:auto}
.hub-header{display:flex;align-items:center;margin-bottom:18px}
.btn-back-main{
  background:none;border:none;color:var(--muted);
  font-size:18px;font-weight:800;cursor:pointer;font-family:inherit;
  display:flex;align-items:center;gap:8px;padding:8px 0;transition:color .2s;
}
.btn-back-main:active{color:#ffffff}
.hub-heading-area{margin-bottom:20px}
.hub-page-title{font-size:38px;font-weight:900;letter-spacing:-.03em;margin-bottom:8px}
.hub-page-subtitle{font-size:18px;color:var(--muted);line-height:1.5;font-weight:700}
.hub-grid{display:flex;flex-direction:column;gap:10px}
.hub-card-item{
  background:var(--card);border:1.5px solid var(--card-border);
  border-radius:var(--radius);padding:20px 18px;
  cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;
  transition:all 0.18s var(--trans);min-height:78px;
}
.hub-card-item:active{border-color:var(--led);transform:scale(0.985);background:rgba(0,240,255,0.08)}
.hub-card-left{display:flex;align-items:center;gap:16px}
.hub-card-icon{font-size:26px;width:50px;height:50px;border-radius:14px;background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,0.1);flex-shrink:0}
.hub-card-title{font-size:20px;font-weight:800;letter-spacing:-.01em;color:#ffffff}
.hub-card-arrow{color:var(--led);font-size:22px;font-weight:900}

/* ── DETAIL SCREENS ── */
.detail-screen{background:var(--navy);padding:22px 18px 40px;overflow-y:auto}
.detail-nav{display:flex;align-items:center;margin-bottom:18px}
.btn-back-hub{
  background:none;border:none;color:var(--muted);font-size:18px;font-weight:800;
  cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:8px;
  padding:8px 0;transition:color .2s;
}
.btn-back-hub:active{color:#ffffff}
.detail-title{font-size:32px;font-weight:900;letter-spacing:-.02em;margin-bottom:20px;color:#ffffff}

/* WHAT */
.what-card-panel{
  background:var(--card);border:1.5px solid var(--card-border);
  border-radius:var(--radius);padding:24px;
  display:flex;flex-direction:column;gap:16px;
}
.what-desc-para{font-size:20px;line-height:1.65;color:var(--muted);font-weight:600}
.what-desc-para strong{color:#ffffff;font-weight:900}

/* COMPONENTS */
.comp-list-container{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.comp-card-item{
  background:var(--card);border:1.5px solid var(--card-border);
  border-radius:14px;padding:16px 14px;
  display:flex;align-items:center;gap:12px;min-height:72px;
}
.comp-card-icon-box{
  width:42px;height:42px;border-radius:10px;
  background:rgba(0,240,255,0.1);border:1.5px solid rgba(0,240,255,0.28);
  display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;
}
.comp-card-name{font-size:15px;font-weight:800;color:#ffffff;display:block;line-height:1.3}
.comp-card-job{font-size:13px;color:var(--muted);display:block;margin-top:3px;font-weight:600}

/* AIM */
.aim-card-highlight{
  background:rgba(0,240,255,0.08);border:1.5px solid rgba(0,240,255,0.38);
  border-radius:var(--radius);padding:22px;margin-bottom:20px;
}
.aim-card-label{font-size:13px;font-weight:900;text-transform:uppercase;color:var(--led);letter-spacing:.14em;margin-bottom:10px}
.aim-card-text{font-size:20px;line-height:1.6;font-weight:700;color:#ffffff}
.obj-list-section{display:flex;flex-direction:column;gap:10px}
.obj-list-title{font-size:13px;font-weight:900;text-transform:uppercase;color:var(--muted);letter-spacing:.12em;margin-bottom:4px}
.obj-card-item{
  background:var(--card);border:1.5px solid var(--card-border);
  border-radius:16px;padding:16px 18px;display:flex;gap:16px;align-items:flex-start;
}
.obj-card-num{
  width:32px;height:32px;border-radius:50%;
  background:rgba(0,240,255,0.12);border:1.5px solid var(--led);
  display:flex;align-items:center;justify-content:center;
  font-size:15px;font-weight:900;color:var(--led);flex-shrink:0;
}
.obj-card-desc{font-size:18px;line-height:1.5;font-weight:700;color:var(--muted);padding-top:4px}

/* FEATURES */
.feats-container{display:flex;flex-direction:column;gap:10px}
.feat-item-card{
  background:var(--card);border:1.5px solid var(--card-border);
  border-radius:var(--radius);padding:20px;display:flex;gap:16px;align-items:flex-start;
}
.feat-item-icon{font-size:28px;flex-shrink:0}
.feat-item-title{font-size:20px;font-weight:900;margin-bottom:6px;display:block;color:#ffffff}
.feat-item-desc{font-size:17px;color:var(--muted);line-height:1.5;display:block;font-weight:600}

/* WORKFLOW */
.workflow-diagram-container{
  width:100%;background:var(--card);border:1.5px solid var(--card-border);
  border-radius:var(--radius);padding:24px 16px;margin-bottom:20px;
  display:flex;justify-content:center;
}
.workflow-notes-container{display:flex;flex-direction:column;gap:12px}
.wf-note-card{border-left:3px solid var(--led);padding-left:16px}
.wf-note-title{font-size:19px;font-weight:900;margin-bottom:5px;display:block;color:#ffffff}
.wf-note-desc{font-size:17px;color:var(--muted);line-height:1.5;display:block;font-weight:600}

/* ADVANTAGES */
.advs-container{display:flex;flex-direction:column;gap:10px}
.adv-item-card{
  background:var(--card);border:1.5px solid var(--card-border);
  border-radius:var(--radius);padding:20px;display:flex;gap:16px;align-items:flex-start;
}
.adv-item-dot{width:12px;height:12px;border-radius:50%;background:var(--led);box-shadow:0 0 12px var(--led);margin-top:6px;flex-shrink:0}
.adv-item-title{font-size:20px;font-weight:900;margin-bottom:6px;display:block;color:#ffffff}
.adv-item-desc{font-size:17px;color:var(--muted);line-height:1.5;display:block;font-weight:600}

::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.18);border-radius:3px}

@media (min-width:500px){
  body{display:flex;justify-content:center;align-items:center;background:#020308}
  #phone-frame{
    position:relative;width:420px;height:860px;
    border-radius:44px;border:9px solid #1c1f32;
    box-shadow:0 30px 80px rgba(0,0,0,0.85);
    overflow:hidden;flex-shrink:0;background:var(--navy);
  }
  .screen,#intro-overlay{position:absolute;border-radius:34px}
}
</style>
</head>
<body>
<div id="phone-frame">

<!-- INTRO -->
<div id="intro-overlay">
  <div class="intro-glow ig1"></div>
  <div class="intro-glow ig2"></div>
  <div class="intro-brand">Computer Exhibition 2026</div>
  <div class="intro-title">Smart<br><span>Stairs</span></div>
  <p class="intro-desc">An interactive simulation of sensor-controlled automated staircase illumination.</p>
  <button class="play-btn" id="playBtn" aria-label="Enter Exhibition">
    <div class="play-icon"></div>
  </button>
  <div class="play-label">Tap to begin</div>
</div>

<!-- MAIN -->
<div id="main" class="screen active">
  <div class="main-header">
    <div class="brand-title">Smart<span>Stairs</span></div>
    <div class="status-pill ready" id="systemStatus">
      <div class="status-dot"></div>
      <span id="statusText">System Ready</span>
    </div>
  </div>

  <div class="scene-outer-container" id="staircaseOuter">
    <div class="staircase-viewport" id="viewport">
      <div class="staircase-scene intro-blur" id="scene">
        <div class="floor-reflection" id="floorLight"></div>
        <div class="step-3d" id="s0"><div class="face riser"></div><div class="face tread"></div><div class="face side-left"></div><div class="face side-right"></div><div class="led-strip"></div></div>
        <div class="step-3d" id="s1"><div class="face riser"></div><div class="face tread"></div><div class="face side-left"></div><div class="face side-right"></div><div class="led-strip"></div></div>
        <div class="step-3d" id="s2"><div class="face riser"></div><div class="face tread"></div><div class="face side-left"></div><div class="face side-right"></div><div class="led-strip"></div></div>
        <div class="step-3d" id="s3"><div class="face riser"></div><div class="face tread"></div><div class="face side-left"></div><div class="face side-right"></div><div class="led-strip"></div></div>
        <div class="step-3d" id="s4"><div class="face riser"></div><div class="face tread"></div><div class="face side-left"></div><div class="face side-right"></div><div class="led-strip"></div></div>
        <div class="step-3d" id="s5"><div class="face riser"></div><div class="face tread"></div><div class="face side-left"></div><div class="face side-right"></div><div class="led-strip"></div></div>
      </div>
    </div>
  </div>

  <div class="control-hud-panel">
    <div class="hud-title">System Control Chain</div>
    <div class="hud-flow">
