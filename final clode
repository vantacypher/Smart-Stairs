<script>
function navigateTo(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  const t=document.getElementById(id);
  if(t){t.classList.add('active');t.scrollTop=0;}
}
function backToMain(){navigateTo('main')}
function backToHub(){navigateTo('hub')}
function openDetail(id){navigateTo('d-'+id)}

const introOverlay=document.getElementById('intro-overlay');
const scene=document.getElementById('scene');
document.getElementById('playBtn').addEventListener('click',()=>{
  introOverlay.classList.add('fade-out');
  scene.classList.add('unblur');
  setTimeout(()=>{introOverlay.style.display='none';},750);
});

document.getElementById('btnExploreTech').addEventListener('click',()=>{
  if(!simulationActive) navigateTo('hub');
});

// ── Staircase layout engine
// Measures the outer container (not the scene element) so dimensions are correct.
// Each step: riser (vertical face) + tread (horizontal face rotated from top edge).
// Side caps fold inward from each side edge.
function layoutSteps(){
  const container=document.getElementById('staircaseOuter');
  const cW=container.offsetWidth;
  const cH=container.offsetHeight;
  const sceneEl=document.getElementById('scene');
  const stepEls=sceneEl.querySelectorAll('.step-3d');
  const n=stepEls.length;

  // Step width = nearly full container width (scene is 92% wide, centered)
  // riserH: divide available vertical space evenly across steps
  // treadD: the depth of the horizontal tread surface
  const riserH=Math.floor(cH*0.72/n);
  const treadD=Math.floor(riserH*1.5);
  const sideW =Math.floor(treadD*0.85);

  stepEls.forEach((step,i)=>{
    // Each step rises by riserH in Y and steps back by treadD in Z
    const yOff = -riserH * i;
    const zOff = -treadD * i;
    step.style.height = riserH+'px';
    step.style.transform = `translate3d(0,${yOff}px,${zOff}px)`;

    // Riser: vertical front face, anchored at top-left of step
    const riser=step.querySelector('.riser');
    riser.style.height=riserH+'px';
    riser.style.width='100%';
    riser.style.top='0';riser.style.left='0';

    // Tread: horizontal top surface.
    // Rotated -90deg around its TOP edge so it lies flat going backwards.
    // Pivot is the top of the riser face = translate 0 on Y, riserH on Z brings
    // the origin to the top edge before rotation.
    const tread=step.querySelector('.tread');
    tread.style.height=treadD+'px';
    tread.style.width='100%';
    tread.style.top='0';tread.style.left='0';
    tread.style.transform=`translate3d(0,0,${riserH}px) rotateX(-90deg)`;
    tread.style.transformOrigin='top center';

    // Side caps: fill the triangular gap on left and right
    const sl=step.querySelector('.side-left');
    sl.style.width=sideW+'px';sl.style.height=riserH+'px';
    sl.style.top='0';sl.style.left='0';
    // fold inward (left cap rotates around its LEFT edge going backward)
    sl.style.transform=`translate3d(0,0,${riserH}px) rotateY(90deg)`;
    sl.style.transformOrigin='left center';

    const sr=step.querySelector('.side-right');
    sr.style.width=sideW+'px';sr.style.height=riserH+'px';
    sr.style.top='0';sr.style.left='';sr.style.right='0';
    // fold inward (right cap rotates around its RIGHT edge going backward)
    sr.style.transform=`translate3d(0,0,${riserH}px) rotateY(-90deg)`;
    sr.style.transformOrigin='right center';
  });
}

window.addEventListener('load', layoutSteps);
window.addEventListener('resize', layoutSteps);
setTimeout(layoutSteps, 50);
setTimeout(layoutSteps, 300);

const btnSimulate=document.getElementById('btnSimulate');
const btnExploreTech=document.getElementById('btnExploreTech');
const statusPill=document.getElementById('systemStatus');
const statusText=document.getElementById('statusText');
const steps=document.querySelectorAll('.step-3d');
const floorLight=document.getElementById('floorLight');
const nodeIR=document.getElementById('node-ir');
const nodeArduino=document.getElementById('node-arduino');
const nodeMosfet=document.getElementById('node-mosfet');
const nodeLEDs=document.getElementById('node-leds');
const pulse1=document.getElementById('pulse-1');
const pulse2=document.getElementById('pulse-2');
const pulse3=document.getElementById('pulse-3');
let simulationActive=false;

function setStatus(txt,cls){statusText.textContent=txt;statusPill.className='status-pill '+cls;}
btnSimulate.addEventListener('click',()=>{if(!simulationActive)runSim();});

function runSim(){
  simulationActive=true;
  btnSimulate.disabled=true;btnExploreTech.disabled=true;
  scene.classList.add('simulation-active');
  steps.forEach(s=>s.classList.remove('lit','lit-below'));
  floorLight.classList.remove('lit');
  document.querySelectorAll('.hud-node').forEach(n=>n.classList.remove('active'));
  [pulse1,pulse2,pulse3].forEach(p=>{p.style.transition='none';p.style.transform='scaleX(0)';});

  setStatus('Movement Detected','detected');nodeIR.classList.add('active');
  setTimeout(()=>{pulse1.style.transition='transform 0.4s linear';pulse1.style.transform='scaleX(1)';},400);
  setTimeout(()=>{setStatus('Processing','processing');nodeArduino.classList.add('active');},800);
  setTimeout(()=>{pulse2.style.transition='transform 0.4s linear';pulse2.style.transform='scaleX(1)';},1200);
  setTimeout(()=>{setStatus('Lighting Active','active-state');nodeMosfet.classList.add('active');},1600);
  setTimeout(()=>{pulse3.style.transition='transform 0.3s linear';pulse3.style.transform='scaleX(1)';nodeLEDs.classList.add('active');},1900);

  const startLED=2200,stepGap=260;
  steps.forEach((step,i)=>{
    setTimeout(()=>{
      step.classList.add('lit');
      if(i>0) steps[i-1].classList.add('lit-below');
      else floorLight.classList.add('lit');
    },startLED+i*stepGap);
  });

  const holdEnd=startLED+steps.length*stepGap+3200;
  const fadeDur=1100;
  setTimeout(()=>{
    steps.forEach(s=>{s.style.transition=`opacity ${fadeDur}ms ease,background ${fadeDur}ms ease`;});
    floorLight.style.transition=`background ${fadeDur}ms ease`;
    steps.forEach(s=>s.classList.remove('lit','lit-below'));
    floorLight.classList.remove('lit');
    document.querySelectorAll('.hud-node').forEach(n=>n.classList.remove('active'));
    [pulse1,pulse2,pulse3].forEach(p=>{p.style.transition='transform 0.8s ease';p.style.transform='scaleX(0)';});
    setStatus('System Ready','ready');
  },holdEnd);
  setTimeout(()=>{
    steps.forEach(s=>{s.style.transition='';});
    floorLight.style.transition='';
    scene.classList.remove('simulation-active');
    simulationActive=false;btnSimulate.disabled=false;btnExploreTech.disabled=false;
  },holdEnd+fadeDur+200);
}
</script>
