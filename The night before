<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Smart Stairs — Interactive Exhibition</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --navy:#060814;
  --card:#121832;
  --card-border:rgba(0,240,255,0.22);
  --led:#00f0ff;
  --walnut:#4a3118;
  --walnut-border:#6a4825;
  --riser:#181a28;
  --text:#ffffff;
  --muted:#d0dcf0;
  --accent:#2563ff;
  --amber:#ffc837;
  --green:#2ec4b6;
  --radius:22px;
  --trans:cubic-bezier(.4,0,.2,1);
}

html,body{
  height:100%;overflow:hidden;
  background:var(--navy);
  font-family:'Outfit',-apple-system,BlinkMacSystemFont,sans-serif;
  color:var(--text);
  -webkit-tap-highlight-color:transparent;
}

/* ── SCREENS ─────────────────────────────── */
.screen{
  position:fixed;inset:0;
  display:flex;flex-direction:column;
  overflow:hidden;
  opacity:0;pointer-events:none;
  transform:translate3d(0,18px,0);
  transition:opacity 0.45s var(--trans),transform 0.45s var(--trans);
  z-index:5;
}
.screen.active{opacity:1;pointer-events:all;transform:translate3d(0,0,0)}

/* ── INTRO OVERLAY ──────────────────────── */
#intro-overlay{
  position:fixed;inset:0;
  background:rgba(6,8,20,0.92);
  backdrop-filter:blur(16px);
  display:flex;flex-direction:column;
  justify-content:center;align-items:center;
  gap:2.2rem;z-index:100;padding:28px;
  text-align:center;
  transition:opacity 0.75s ease;
}
#intro-overlay.fade-out{opacity:0;pointer-events:none}

.intro-brand{font-size:14px;letter-spacing:.28em;text-transform:uppercase;color:var(--muted);font-weight:700}
.intro-title{font-size:clamp(50px,14vw,68px);font-weight:900;letter-spacing:-.03em;line-height:1.02}
.intro-title span{color:var(--led);text-shadow:0 0 32px rgba(0,240,255,0.5)}
.intro-desc{font-size:18px;color:var(--muted);max-width:340px;line-height:1.5;font-weight:500}

.play-btn{
  width:104px;height:104px;border-radius:50%;
  background:rgba(0,240,255,0.12);
  border:2px solid rgba(0,240,255,0.45);
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;
  transition:transform 0.28s var(--trans), background-color 0.28s var(--trans);
  box-shadow:0 0 40px rgba(0,240,255,0.2);
  position:relative;
}
.play-btn::before{
  content:'';position:absolute;inset:-9px;border-radius:50%;
  border:1.5px solid rgba(0,240,255,0.25);
  animation:pulsering 2.2s ease-in-out infinite;
}
@keyframes pulsering{0%,100%{transform:scale(1);opacity:.4}50%{transform:scale(1.08);opacity:1}}
.play-btn:active{background:rgba(0,240,255,0.25);transform:scale(0.95)}
.play-icon{width:0;height:0;border-style:solid;border-width:14px 0 14px 26px;border-color:transparent transparent transparent var(--led);margin-left:7px;filter:drop-shadow(0 0 8px var(--led))}
.play-label{font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);font-weight:700}

/* Ambient glowing backgrounds */
.intro-glow{position:absolute;border-radius:50%;pointer-events:none}
.ig1{width:300px;height:300px;background:radial-gradient(circle,rgba(0,240,255,0.14),transparent 70%);animation:roam1 9s ease-in-out infinite}
.ig2{width:260px;height:260px;background:radial-gradient(circle,rgba(37,99,255,0.12),transparent 70%);animation:roam2 12s ease-in-out infinite}
@keyframes roam1{0%,100%{transform:translate3d(-70px,-90px,0)}40%{transform:translate3d(80px,-30px,0)}70%{transform:translate3d(10px,80px,0)}}
@keyframes roam2{0%,100%{transform:translate3d(70px,80px,0)}40%{transform:translate3d(-80px,40px,0)}70%{transform:translate3d(-10px,-80px,0)}}

/* ── MAIN SCREEN ────────────────────────── */
#main{background:var(--navy);padding:18px 18px 22px}
.main-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-shrink:0}
.brand-title{font-size:24px;font-weight:900;letter-spacing:-.02em}
.brand-title span{color:var(--led)}

.status-pill{
  display:flex;align-items:center;gap:10px;
  background:rgba(255,255,255,0.06);border:1.5px solid var(--card-border);
  padding:8px 16px;border-radius:24px;
  font-size:13px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;
}
.status-dot{width:10px;height:10px;border-radius:50%}
.status-pill.ready .status-dot{background:var(--green);box-shadow:0 0 10px var(--green);animation:blink 2s infinite}
.status-pill.detected .status-dot{background:var(--amber);box-shadow:0 0 10px var(--amber);animation:blink 0.8s infinite}
.status-pill.processing .status-dot{background:var(--accent);box-shadow:0 0 10px var(--accent);animation:blink 0.4s infinite}
.status-pill.active-state .status-dot{background:var(--led);box-shadow:0 0 10px var(--led);animation:blink 1.2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}

/* 3D SCENE - STAIRCASE EXPANDED TO FILL ENTIRE BOX */
.scene-outer-container{
  flex:1;position:relative;width:100%;
  min-height:300px;
  display:flex;flex-direction:column;justify-content:center;align-items:center;
  overflow:hidden;border-radius:var(--radius);
  background:radial-gradient(circle at 50% 50%,#101632 0%,#060814 100%);
  border:2px solid rgba(0,240,255,0.3);
  margin-bottom:14px;
  box-shadow:inset 0 0 40px rgba(0,240,255,0.08);
}

.staircase-viewport{
  width:100%;height:100%;
  position:relative;
  perspective:780px;perspective-origin:50% 12%;
  display:flex;justify-content:center;align-items:center;
}
.staircase-scene{
  position:relative;width:320px;height:260px;
  transform-style:preserve-3d;
  transform:rotateX(36deg) rotateY(0deg) rotateZ(0deg);
  will-change:transform;
}
.staircase-scene.intro-blur{filter:blur(14px);transition:filter 0s}
.staircase-scene.intro-blur.unblur{filter:blur(0px);transition:filter 1.1s ease}

/* 3D STEP - EXPANDED BREADTH (320px) FILLING CONTAINER */
.step-3d{
  position:absolute;left:0;top:0;
  width:320px;height:36px;
  transform-style:preserve-3d;
  will-change:transform;
}
.step-3d .face{position:absolute;backface-visibility:visible}

/* Tread (Top horizontal surface) */
.step-3d .tread{
  width:320px;height:52px;left:0;top:0;
  background:linear-gradient(135deg,#3d2915 0%,#1f140a 100%);
  border:1px solid #5a3e20;
  transform:translate3d(0,0,4px) rotateX(-90deg);
  transform-origin:top center;
  border-radius:2px;
}
.step-3d .tread::after{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at 50% 0%,rgba(0,240,255,0),transparent 75%);
  transition:background 0.4s ease;border-radius:2px;
}
.step-3d.lit-below .tread::after{background:radial-gradient(ellipse at 50% 0%,rgba(0,240,255,0.35),transparent 75%)}

/* Riser (Vertical face) */
.step-3d .riser{
  width:320px;height:36px;left:0;top:0;
  background:var(--riser);
  border:1px solid rgba(255,255,255,0.08);
  transition:background 0.35s ease;
}
.step-3d.lit .riser{background:linear-gradient(180deg,rgba(0,240,255,0.55) 0%,rgba(0,240,255,0.14) 60%,var(--riser) 100%)}

/* Side caps */
.step-3d .side-left,.step-3d .side-right{
  width:52px;height:36px;top:0;
  background:#0f101a;border:1px solid rgba(255,255,255,0.05);
}
.step-3d .side-left{left:0;transform:translate3d(0,0,4px) rotateY(-90deg);transform-origin:left center}
.step-3d .side-right{left:320px;transform:translate3d(0,0,4px) rotateY(-90deg);transform-origin:left center}

/* LED Edge Strip */
.step-3d .led-strip{
  position:absolute;top:0;left:0;width:320px;height:5px;
  background:var(--led);
  box-shadow:0 0 18px var(--led),0 2px 8px rgba(0, 240, 255, 0.95);
  opacity:0.28;
  transform:translate3d(0,0,1px);
  transition:opacity 0.35s ease;
  will-change:opacity;
}
.step-3d.lit .led-strip{
  opacity:1 !important;
}

.staircase-scene:not(.simulation-active) .step-3d:not(.lit) .led-strip{animation:ledbreath 3s ease-in-out infinite}
.staircase-scene:not(.simulation-active) .step-3d:nth-child(2):not(.lit) .led-strip{animation-delay:.3s}
.staircase-scene:not(.simulation-active) .step-3d:nth-child(3):not(.lit) .led-strip{animation-delay:.6s}
.staircase-scene:not(.simulation-active) .step-3d:nth-child(4):not(.lit) .led-strip{animation-delay:.9s}
.staircase-scene:not(.simulation-active) .step-3d:nth-child(5):not(.lit) .led-strip{animation-delay:1.2s}
.staircase-scene:not(.simulation-active) .step-3d:nth-child(6):not(.lit) .led-strip{animation-delay:1.5s}

@keyframes ledbreath{0%,100%{opacity:0.25}50%{opacity:0.7}}

.floor-reflection{
  position:absolute;width:400px;height:400px;
  background:radial-gradient(circle at 50% 55%,rgba(0,240,255,0),transparent 60%);
  transform:translate3d(-40px,40px,0) rotateX(90deg);
  pointer-events:none;transition:background 0.5s ease;
}
.floor-reflection.lit{background:radial-gradient(circle at 50% 55%,rgba(0,240,255,0.25),transparent 60%)}

/* HUD PANEL */
.control-hud-panel{
  width:100%;background:var(--card);border:1.5px solid var(--card-border);
  backdrop-filter:blur(12px);
  border-radius:var(--radius);padding:16px 16px;
  display:flex;flex-direction:column;gap:10px;margin-bottom:14px;flex-shrink:0;
}
.hud-title{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;font-weight:800}
.hud-flow{display:flex;align-items:center;justify-content:space-between;position:relative}
.hud-node{display:flex;flex-direction:column;align-items:center;gap:6px;z-index:2;width:64px}
.hud-node-circle{
  width:46px;height:46px;border-radius:50%;
  background:rgba(255,255,255,0.05);border:1.5px solid var(--card-border);
  display:flex;align-items:center;justify-content:center;font-size:20px;
  transition:all 0.28s var(--trans);
}
.hud-node-label{font-size:11px;color:var(--muted);text-align:center;font-weight:700;text-transform:uppercase;white-space:nowrap}
.hud-node.active .hud-node-circle{background:rgba(0,240,255,0.18);border-color:var(--led);box-shadow:0 0 16px rgba(0,240,255,0.45);transform:scale(1.12)}
.hud-node.active .hud-node-label{color:var(--text)}
.hud-connector{flex:1;height:3px;background:rgba(255,255,255,0.08);margin:0 -4px 18px;position:relative;overflow:hidden}

.hud-connector-pulse{
  position:absolute;top:0;left:0;height:100%;
  width:100%;background:var(--led);
  box-shadow:0 0 8px var(--led);
  transform:scaleX(0);
  transform-origin:left center;
  will-change:transform;
}

/* MAIN ACTIONS */
.main-actions{display:flex;flex-direction:column;gap:10px;width:100%;flex-shrink:0}

.btn-simulate, .btn-explore-tech, .btn-explore {
  width: 100%; padding: 16px; border-radius: 18px;
  background: linear-gradient(135deg,rgba(0,240,255,0.22),rgba(37,99,255,0.18));
  border: 1.5px solid rgba(0,240,255,0.45);
  color: #ffffff; font-size: 17px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
  cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px;
  transition: transform 0.22s var(--trans), background-color 0.22s var(--trans), opacity 0.22s var(--trans); font-family: inherit;
  box-shadow: 0 4px 20px rgba(0,240,255,0.12);
}
.btn-simulate:active, .btn-explore-tech:active, .btn-explore:active {
  transform: scale(0.97); background: rgba(0,240,255,0.28);
}
.btn-simulate:disabled, .btn-explore-tech:disabled {
  opacity: .45; pointer-events: none;
}
.btn-simulate-icon{font-size:20px}

/* ── WELCOME MODAL ──────────────────────── */
.welcome-overlay{
  position:fixed;inset:0;
  background:rgba(6,8,20,0.88);
  backdrop-filter:blur(12px);
  z-index:150;display:flex;align-items:center;justify-content:center;padding:24px;
  opacity:0;pointer-events:none;
  transition:opacity 0.38s var(--trans);
}
.welcome-overlay.show{opacity:1;pointer-events:all}
.welcome-card{
  background:rgba(18,24,50,0.95);border:1.5px solid var(--card-border);
  border-radius:26px;padding:36px 28px;
  width:100%;max-width:380px;text-align:center;
  transform:translate3d(0,18px,0);transition:transform 0.38s var(--trans);
  box-shadow:0 24px 60px rgba(0,0,0,0.7);
}
.welcome-overlay.show .welcome-card{transform:translate3d(0,0,0)}
.welcome-status-dot{width:12px;height:12px;border-radius:50%;background:var(--led);box-shadow:0 0 14px var(--led);margin:0 auto 20px}
.welcome-title{font-size:32px;font-weight:900;margin-bottom:14px;letter-spacing:-.02em}
.welcome-text{font-size:18px;color:var(--muted);line-height:1.6;margin-bottom:28px;font-weight:500}

/* ── HUB ────────────────────────────────── */
#hub{background:var(--navy);padding:22px 20px 32px;overflow-y:auto}
.hub-header{display:flex;align-items:center;margin-bottom:20px;flex-shrink:0}
.btn-back-main{
  background:none;border:none;color:var(--muted);
  font-size:17px;font-weight:700;cursor:pointer;font-family:inherit;
  display:flex;align-items:center;gap:8px;padding:8px 0;transition:color .2s;
}
.btn-back-main:active{color:var(--text)}
.hub-heading-area{margin-bottom:22px}
.hub-page-title{font-size:36px;font-weight:900;letter-spacing:-.03em;margin-bottom:8px}
.hub-page-subtitle{font-size:17px;color:var(--muted);line-height:1.5;font-weight:500}
.hub-grid{display:flex;flex-direction:column;gap:12px;flex:1}
.hub-card-item{
  background:var(--card);border:1.5px solid var(--card-border);
  backdrop-filter:blur(10px);
  border-radius:var(--radius);padding:20px 18px;
  cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;
  transition:all 0.2s var(--trans);min-height:80px;
}
.hub-card-item:active{border-color:var(--led);transform:scale(0.985);background:rgba(0,240,255,0.08)}
.hub-card-left{display:flex;align-items:center;gap:16px}
.hub-card-icon{font-size:26px;width:48px;height:48px;border-radius:14px;background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,0.1);flex-shrink:0}
.hub-card-title{font-size:19px;font-weight:800;letter-spacing:-.01em}
.hub-card-arrow{color:var(--led);font-size:22px;font-weight:800}

/* ── DETAIL SCREENS ─────────────────────── */
.detail-screen{background:var(--navy);padding:22px 20px 40px;overflow-y:auto}
.detail-nav{display:flex;align-items:center;margin-bottom:20px;flex-shrink:0}
.btn-back-hub{background:none;border:none;color:var(--muted);font-size:17px;font-weight:700;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:8px;padding:8px 0;transition:color .2s}
.btn-back-hub:active{color:var(--text)}
.detail-title{font-size:32px;font-weight:900;letter-spacing:-.02em;margin-bottom:22px;color:#ffffff}

/* WHAT */
.what-card-panel{
  background:var(--card);border:1.5px solid var(--card-border);
  border-radius:var(--radius);padding:26px;margin-bottom:20px;
  display:flex;flex-direction:column;gap:18px;
}
.what-desc-para{font-size:19px;line-height:1.65;color:var(--text);font-weight:500}
.what-desc-para strong{color:var(--led);font-weight:800}

/* COMPONENTS - SNUG COMPACT 2-COLUMN GRID (NO EMPTY SPACE) */
.comp-list-container{
  display:grid;
  grid-template-columns:repeat(2, 1fr);
  gap:10px;
}
.comp-card-item{
  background:var(--card);border:1.5px solid var(--card-border);
  border-radius:14px;padding:12px 14px;
  display:flex;align-items:center;gap:12px;
}
.comp-card-icon-box{
  width:40px;height:40px;border-radius:10px;
  background:rgba(0,240,255,0.08);border:1.5px solid rgba(0,240,255,0.25);
  display:flex;align-items:center;justify-content:center;
  font-size:20px;flex-shrink:0;
}
.comp-card-name{font-size:15px;font-weight:800;display:block;color:#ffffff;line-height:1.3}
.comp-card-job{font-size:12px;color:var(--muted);line-height:1.3;display:block;font-weight:500;margin-top:2px}

/* AIM */
.aim-card-highlight{background:rgba(0,240,255,0.08);border:1.5px solid rgba(0,240,255,0.35);border-radius:var(--radius);padding:22px;margin-bottom:22px}
.aim-card-label{font-size:13px;font-weight:800;text-transform:uppercase;color:var(--led);letter-spacing:.12em;margin-bottom:8px}
.aim-card-text{font-size:19px;line-height:1.6;font-weight:600;color:#ffffff}
.obj-list-section{display:flex;flex-direction:column;gap:12px}
.obj-list-title{font-size:13px;font-weight:800;text-transform:uppercase;color:var(--muted);letter-spacing:.1em;margin-bottom:2px}
.obj-card-item{background:var(--card);border:1.5px solid var(--card-border);border-radius:16px;padding:16px 18px;display:flex;gap:16px;align-items:flex-start}
.obj-card-num{width:30px;height:30px;border-radius:50%;background:rgba(0,240,255,0.12);border:1.5px solid var(--led);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;color:var(--led);flex-shrink:0}
.obj-card-desc{font-size:17px;line-height:1.5;font-weight:600;color:#ffffff;padding-top:2px}

/* FEATURES */
.feats-container{display:flex;flex-direction:column;gap:12px}
.feat-item-card{background:var(--card);border:1.5px solid var(--card-border);border-radius:var(--radius);padding:18px;display:flex;gap:16px;align-items:flex-start}
.feat-item-icon{font-size:28px;flex-shrink:0}
.feat-item-title{font-size:19px;font-weight:800;margin-bottom:4px;display:block;color:#ffffff}
.feat-item-desc{font-size:16px;color:var(--muted);line-height:1.45;display:block;font-weight:500}

/* WORKFLOW */
.workflow-diagram-container{width:100%;background:var(--card);border:1.5px solid var(--card-border);border-radius:var(--radius);padding:24px 16px;margin-bottom:20px;display:flex;justify-content:center}
.workflow-notes-container{display:flex;flex-direction:column;gap:12px}
.wf-note-card{border-left:3px solid var(--led);padding-left:14px}
.wf-note-title{font-size:17px;font-weight:800;margin-bottom:3px;display:block;color:#ffffff}
.wf-note-desc{font-size:15px;color:var(--muted);line-height:1.45;display:block;font-weight:500}

/* ADVANTAGES */
.advs-container{display:flex;flex-direction:column;gap:12px}
.adv-item-card{background:var(--card);border:1.5px solid var(--card-border);border-radius:var(--radius);padding:18px;display:flex;gap:14px;align-items:flex-start}
.adv-item-dot{width:10px;height:10px;border-radius:50%;background:var(--led);box-shadow:0 0 10px var(--led);margin-top:7px;flex-shrink:0}
.adv-item-title{font-size:19px;font-weight:800;margin-bottom:4px;display:block;color:#ffffff}
.adv-item-desc{font-size:16px;color:var(--muted);line-height:1.45;display:block;font-weight:500}

/* SCROLLBAR */
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.2);border-radius:3px}

/* DESKTOP PHONE FRAME */
@media (min-width:500px){
  body{display:flex;justify-content:center;align-items:center;background:#020308}
  #phone-frame{
    position:relative;width:420px;height:860px;
    border-radius:44px;border:9px solid #1c1f32;
    box-shadow:0 30px 80px rgba(0,0,0,0.85);
    overflow:hidden;flex-shrink:0;
    background:var(--navy);
  }
  .screen,#intro-overlay,.welcome-overlay{
    position:absolute;
    border-radius:34px;
  }
}
</style>
</head>
<body>

<div id="phone-frame">

<!-- ══ INTRO OVERLAY ══ -->
<div id="intro-overlay">
  <div class="intro-glow ig1"></div>
  <div class="intro-glow ig2"></div>
  <div class="intro-brand">Computer Exhibition 2026</div>
  <div class="intro-title">Smart<br><span>Stairs</span></div>
  <p class="intro-desc">An interactive simulation of sensor-controlled automated staircase illumination.</p>
  <button class="play-btn" id="playBtn" aria-label="Enter Exhibition">
    <div class="play-icon"></div>
  </button>
  <div class="play-label">Tap to begin</div>
</div>

<!-- ══ MAIN SCREEN ══ -->
<div id="main" class="screen active">
  <div class="main-header">
    <div class="brand-title">Smart<span>Stairs</span></div>
    <div class="status-pill ready" id="systemStatus">
      <div class="status-dot"></div>
      <span id="statusText">System Ready</span>
    </div>
